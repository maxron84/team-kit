
# --- T.E.A.M.-Loop-Laufzeitartefakte (T.E.A.M.-Starterkit) -------------------
# Bewusst auf den team/-Namensraum und die Zustandsdateien begrenzt — das Kit
# bringt KEINE stack-spezifischen Einträge in dein Projekt.
.ralph-logs/
.team-logs/
.team-loop.lock
.team-loop.lock.d/
.ralph-state
.ralph-plan
.harry-state
.marv-state
.vollautomatik-state
# BL-255: welche Stufen planmaessig ausgelassen wurden (Lauf-Zustand).
.ralph-uebersprungen
# BL-256: der Ort, an dem 'das Gate ist seit HH:MM rot' stehen kann.
.team-gate-rot
.team-focus-harry
.team-focus-marv
.frank-attempts
.budget-ledger.lock
backups/

# Laufzeitartefakte der Team-Werkzeuge (Python) — NUR unter team/.
team/**/__pycache__/
team/**/.pytest_cache/

# --- Ordner des Stakeholders (BL-263) -----------------------------------------
# Rohmaterial (TEAM_ROHMATERIAL_ORDNER): Hier legt NUR der Mensch ab, das
# T.E.A.M. liest nur. Bewusst NICHT versioniert — so kann kein Guard und kein
# Rollback dort etwas loeschen. Heissen die Ordner in team.config.* anders,
# diese Zeilen mitziehen. Clippings/ legt das Kit nicht an; es taucht auf,
# sobald dort Web-Clippings landen.
/raw/
/Clippings/
# Die Arbeitsflaeche des Notizwerkzeugs (Obsidian) — fuer das T.E.A.M.
# komplett ignoriert: nicht lesen, nicht schreiben, nicht ueberwachen.
/.obsidian/
